# ---------------------------------------------------------------------------
# Chat Harness configuration. Copy to `.env` and fill in what you use.
# Providers are auto-detected: a provider shows up in the web UI if its API key
# is set (or, for keyless local engines, if its /models endpoint is reachable).
# ---------------------------------------------------------------------------

# --- Cloud OpenAI-compatible providers (set the key to enable) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for Azure/proxy if needed

OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   # override if needed

XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1   # override if needed

# --- Local OpenAI-compatible engines (keyless; enabled when reachable) ---
# Inside Docker, use host.docker.internal instead of localhost/127.0.0.1 to
# reach an engine running on the host (compose maps it via host-gateway).
LLAMACPP_BASE_URL=http://localhost:8080/v1

# --- Research stack (self-hosted, no keys) — point at your own instances ---
FIRECRAWL_API_URL=http://<your-firecrawl-host>:3002
CAMOFOX_URL=http://<your-camofox-host>:9377
# Search middleware (searchmw, ships with the Firecrawl stack) hit directly for
# image search (/images). Unset -> the image_search tool reports it's unconfigured.
IMAGE_SEARCH_URL=http://<your-firecrawl-host>:3003

# --- Paths ---
# Directory the bash/file tools operate in (the agent's "workspace").
WORKSPACE_DIR=./workspace
# Where conversations are stored.
DATA_DIR=./data
# LLM-Wiki directory: the assistant's entire durable knowledge — system prompt
# (home.md), memory, lessons — as markdown pages it reads and rewrites itself.
WIKI_DIR=./wiki
# MCP server definitions.
MCP_CONFIG_PATH=./mcp.json

# --- Default model order (shared by every surface) ---
# Every NEW conversation — web UI, Discord DM, Discord channel mention — starts
# on this model. The preferred default is tried first; if its provider isn't
# available right now (e.g. the local llama.cpp server is down), the fallback is
# used. DEFAULT_MODEL blank => "whatever the provider serves first" (good for
# llama.cpp). EFFORT applies only to providers that support it (DeepSeek/OpenRouter).
DEFAULT_PROVIDER=llamacpp
DEFAULT_MODEL=
DEFAULT_EFFORT=
FALLBACK_PROVIDER=deepseek
FALLBACK_MODEL=deepseek-v4-flash
FALLBACK_EFFORT=high

# --- Provider detection cache ---
# Keyless local engines (llama.cpp) are probed via a real HTTP GET /models on a
# SHORT cache (PROVIDER_LIVENESS_CACHE_TTL) — a TCP connect isn't enough, since
# a port-forward / server-with-no-model accepts TCP but never answers. Keyed
# cloud providers are listed when their key is set, and their (large) model list
# is fetched at most once per PROVIDER_MODELS_CACHE_TTL.
PROVIDER_MODELS_CACHE_TTL=86400    # seconds — cloud model list cache (default: 1 day)
PROVIDER_LIVENESS_CACHE_TTL=10     # seconds — keyless liveness probe cache (default: 10)
PROVIDER_LIVENESS_TIMEOUT=2        # seconds per keyless /models probe (default: 2)

# --- Discord ---
# Set a bot token to connect to Discord on startup (same process as the web UI).
# Leave empty for web-UI-only. The bot replies to DMs, @mentions, and replies.
# The model the bot uses comes from the default order above (per-conversation in
# DMs, switchable with /model; channel mentions always use the default).
DISCORD_BOT_TOKEN=
# Discord is multi-user; the shell/file tools run in this container. Keep off
# unless you trust everyone who can reach the bot.
DISCORD_ENABLE_SHELL=false
# Stream DM replies by editing the message in place (~1 edit/s — Discord has no
# real token streaming). Off = the reply arrives as one complete message.
DISCORD_STREAM_DMS=false

# --- Discord context window ---
# Hybrid time/count window over live Discord channel history.
CONTEXT_MESSAGE_COUNT=50
CONTEXT_TIME_WINDOW_HOURS=24
CONTEXT_ACTIVITY_THRESHOLD=30
CONTEXT_MAX_MESSAGES=150
CONTEXT_MAX_CHARS=16000

# --- Speech-to-text (web UI mic button) ---
# faster-whisper model size for local transcription: tiny/base/small/medium.
# Downloads once into DATA_DIR/stt-models on first use. Multilingual.
STT_MODEL=base

# --- Thinking / reasoning ---
# Chat-template kwarg that toggles model reasoning per request. The 💭 button in
# the UI flips this. Default fits this gemma/Qwen-style template; change if your
# model uses a different key (e.g. "thinking").
THINK_KWARG=enable_thinking

# --- Limits ---
BASH_TIMEOUT=120          # seconds per bash command
MAX_AGENT_ITERATIONS=25   # max tool-call rounds per turn
